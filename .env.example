# Copia este archivo a .env (local) o configura estas variables en Vercel.

# URL de PostgreSQL con pooling (Neon: "Pooled connection"; Supabase: puerto 6543 con ?pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Opcional: conexión directa (sin pooler) para `npx prisma db push` / migraciones
DIRECT_URL=""

# NextAuth
NEXTAUTH_SECRET="genera-uno-con: openssl rand -hex 32"
NEXTAUTH_URL="https://tu-app.vercel.app"

# Google AI Studio (Gemini). Vacío = motor heurístico offline
GEMINI_API_KEY=""

# Opcional: rate limiting distribuido (Upstash Redis REST). Vacío = límite en memoria
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
